# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Required: PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required: port the Express server listens on
PORT=3000

# Required: secret used to sign JWT tokens — use a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Optional: comma-separated CORS origins (not needed for single-deployment)
ALLOWED_ORIGINS=

# Required: AWS S3 for image storage
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=eu-west-2
AWS_S3_BUCKET=medisync-hms-images

# Optional: SMTP settings for appointment reminder emails (leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
